# Copy this file to .env and fill in real values. See app/core/config.py for the
# authoritative list of settings and their DOC_EXTRACTION_-prefixed aliases.

# --- OCR providers (app/services/document_parser.py) ---
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=
GOOGLE_VISION_CREDENTIALS_FILE=
OCR_PROVIDER=azure

# --- LLM extraction (app/services/openai_extractor.py) ---
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-nano

# --- Database (app/db/connectiondb.py) ---
# Optional for local dev/tests: DB access no-ops gracefully when unset.
DATABASE_URL=
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=8

# --- Job queue (app/services/redis_queue.py, app/worker.py) ---
# JOB_QUEUE_MODE=direct runs the pipeline inline with no Redis/Postgres required (default, used in tests).
# JOB_QUEUE_MODE=redis enables the async worker; requires REDIS_* and DATABASE_URL.
JOB_QUEUE_MODE=direct
JOB_QUEUE_NAME=agentic-doc-extraction:jobs
JOB_QUEUE_WAIT_TIMEOUT_SECONDS=900
JOB_QUEUE_POLL_INTERVAL_MS=500

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDISINSIGHT_DOMAIN=

# API_KEY guards the parsing endpoints; leave unset to disable auth locally.
API_KEY=

# APP_ROLE=api runs the FastAPI server; APP_ROLE=worker runs the queue worker
# (see docker-entrypoint.sh — both roles are served by the same image).
APP_ROLE=api

# --- Processing limits ---
MAX_UPLOAD_PAGES=50
PROCESSING_MAX_CONCURRENT_DOCUMENTS=2
PROCESSING_LARGE_DOCUMENT_PAGE_THRESHOLD=50
OPENAI_MAX_INPUT_TOKENS=45000
OPENAI_CHUNK_TARGET_TOKENS=24000
OPENAI_CHUNK_MAX_PAGES=12
OPENAI_CHUNK_OVERLAP_PAGES=1

# --- Server tuning (docker-entrypoint.sh / Dockerfile) ---
WEB_CONCURRENCY=2
UVICORN_LIMIT_CONCURRENCY=16
UVICORN_TIMEOUT_KEEP_ALIVE=10
